# PostgreSQL usado pelo Docker Compose
POSTGRES_DB=agsolucoes_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local

# Conexão da API quando executada fora do Docker.
# Dentro do Compose, a URL é sobrescrita para usar o hostname "postgres".
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/agsolucoes_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres_local
